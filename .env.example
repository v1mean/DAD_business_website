# ===========================================
# Supabase Configuration
# ===========================================

# Your Supabase project URL (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (SECRET — server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# Application Configuration
# ===========================================

# The public-facing base URL of your site (used for QR codes and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business Telegram username (without @)
NEXT_PUBLIC_TELEGRAM_USERNAME=your_telegram_username

# Default currency code
NEXT_PUBLIC_CURRENCY=USD

# ===========================================
# Admin Dashboard Authentication (Server-only)
# ===========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
